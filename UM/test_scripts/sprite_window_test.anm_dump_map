entry {
	path: "original_data/sexy_square.png",
	img_width: 128,
	img_height: 128,
	sprites: {
		sprite0: {x: 0.0, y: 0.0, w: 128.0, h: 128.0}
	}
}

const float WINDOW_SCALE_X = 640.0 / 128.0; // 640 / sprite_width
const float WINDOW_SCALE_Y = 480.0 / 128.0; // 480 / sprite_height

script 0 script0 {
	sprite_set(sprite0);
	layer(Layer8);
	render_mode(RenderMode1);
	
	// Center of screen
	move_position(0.0, 224.0, 0.0);
	
	// UV rotation
	F0 = 0.0;
	
	loop {
		// Set BS values to manipulate UV
		origin_mode(OriginMode0);
		scale(WINDOW_SCALE_X, WINDOW_SCALE_Y);
		// backup original position/rotation
		__UNKNOWN_X = SELF_X;
		__UNKNOWN_Y = SELF_Y;
		__UNKNOWN_Z = SELF_Z_ROT;
		move_position(
			640.0 + WINDOW_SCALE_X * 64.0, // offset for center X anchor mode
			480.0 + WINDOW_SCALE_Y * 64.0, // offset for center Y anchor mode
			0.0
		);
		rotation(0.0, 0.0, F0);
		sprite_window();
		// Restore sane/original values
		origin_mode(OriginMode1);
		scale(1.0, 1.0);
		move_position(__UNKNOWN_X, __UNKNOWN_Y, 0.0);
		rotation(0.0, 0.0, __UNKNOWN_Z);
		// rotate the UV
		F0 += 0.0523599;
		math_reduce_angle(F0);
+1:
	}
}

script 1 script1 {
	sprite_set(sprite0);
	layer(Layer8);
	render_mode(RenderMode1);
	
	// Center of screen
	move_position(0.0, 224.0, 0.0);
	
	// UV rotation
	F0 = 0.0;
	rotation_speed(0.0, 0.0, 0.0523599);
	
	loop {
		// Set BS values to manipulate UV
		origin_mode(OriginMode0);
		scale(WINDOW_SCALE_X, WINDOW_SCALE_Y);
		// backup original position/rotation
		__UNKNOWN_X = SELF_X;
		__UNKNOWN_Y = SELF_Y;
		__UNKNOWN_Z = SELF_Z_ROT;
		move_position(
			640.0 + WINDOW_SCALE_X * 64.0, // offset for center X anchor mode
			480.0 + WINDOW_SCALE_Y * 64.0, // offset for center Y anchor mode
			0.0
		);
		rotation(0.0, 0.0, F0);
		sprite_window();
		// Restore sane/original values
		origin_mode(OriginMode1);
		scale(1.0, 1.0);
		move_position(__UNKNOWN_X, __UNKNOWN_Y, 0.0);
		rotation(0.0, 0.0, __UNKNOWN_Z);
		// rotate the UV
		F0 += 0.0523599;
		math_reduce_angle(F0);
+1:
	}
}

script 2 script2 {
	sprite_set(sprite0);
	layer(Layer8);
	render_mode(RenderMode1);
	
	
	// Set BS values to manipulate UV
	origin_mode(OriginMode0);
	scale(WINDOW_SCALE_X, WINDOW_SCALE_Y);
	
	rotation(0.0, 0.0, -0.785398);
	
	sprite_window();
	
	origin_mode(OriginMode1);
	scale(1.0, 1.0);
	
	// Center of screen
	move_position(0.0, 224.0, 0.0);
	rotation(0.0, 0.0, 0.0);
	anm_halt();
}

script 3 script3 {
	sprite_set(sprite0);
	layer(Layer8);
	render_mode(RenderMode1);
	
	// Center of screen
	move_position(0.0, 224.0, 0.0);
	rotation_speed(0.0, 0.0, 0.0523599);
	anm_halt();
}